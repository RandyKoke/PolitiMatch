APP_NAME=PolitiMatch
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

# Origines autorisées pour les requêtes CORS (séparées par une virgule).
# En production (service unique Railway), APP_URL suffit puisque frontend
# et API partagent la même origine. Utile surtout en local, où le serveur
# de dev Vite tourne sur un port distinct de php artisan serve.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:8000

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Connexion PostgreSQL — Railway fournit ces variables automatiquement
# via son template "Laravel + PostgreSQL" (voir cahier des charges §8.3).
# En local, ces valeurs correspondent au conteneur PostgreSQL 16 défini
# dans docker-compose.yml (docker compose up -d).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=politimatch
DB_USERNAME=postgres
DB_PASSWORD=politimatch_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# En production (service unique Railway), laisser vide : le cookie
# reste alors scopé au domaine exact de la requête (frontend et API
# étant servis depuis la même origine, aucune valeur explicite n'est nécessaire).
SESSION_DOMAIN=null

# Domaines autorisés à recevoir les cookies d'authentification Sanctum (mode SPA).
# En local : le host Laragon. En production : le domaine Railway unique
# (frontend et backend étant servis par le même service).
SANCTUM_STATEFUL_DOMAINS=politimatch.test,localhost,127.0.0.1:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# OAuth Google (Laravel Socialite) — cf. social_accounts. Valeurs réelles
# uniquement dans .env local (jamais commité) ou en variables d'env Railway.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

VITE_APP_NAME="${APP_NAME}"
